# Copy to `.env` for local development. Production values live in the committed
# `.env.production` (loaded automatically by `vite build`).
VITE_API_BASE_URL=http://localhost:3000

# Google sign-in is backend-driven (OAuth authorization-code / redirect flow), so
# the frontend needs no Google config. Enable it by setting GOOGLE_CLIENT_ID,
# GOOGLE_CLIENT_SECRET, GOOGLE_CALLBACK_URL and GOOGLE_POST_LOGIN_REDIRECT on the
# backend; the "Continue with Google" button just navigates to the backend.
